---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductMedia from '../components/ProductMedia.astro';
import Price from '../components/Price.astro';
import SaleNote from '../components/SaleNote.astro';
import Marquee from '../components/Marquee.astro';
import Reviews from '../components/Reviews.astro';
import Logo from '../components/Logo.astro';
import { getProducts, isPurchasable, productUrl, shortMaterial, type Category, type Product } from '../lib/catalog';
import { site } from '../data/site';
import heroPainting from '../assets/art/altered-beliefs.jpg';
import doorPainting from '../assets/art/regarding-my-wayward-ways.jpg';
import water from '../assets/brand/water.jpg';

const products = await getProducts();
const necklaces = products.filter((p) => p.data.category === 'necklaces');
const originals = products.filter((p) => p.data.category === 'originals');
const forSale = (list: Product[]) => list.filter(isPurchasable);

const heroPiece = products.find((p) => p.id === 'smoke-necklace' && isPurchasable(p)) ?? forSale(necklaces)[0];
// Smoke's raking-light detail fills an arch; any other piece shows its framed cover.
const heroPieceImage = heroPiece?.id === 'smoke-necklace' ? 7 : undefined;

// The named stones: up to eight necklaces for sale, shown whole at one size, four across.
const stones = forSale(necklaces).slice(0, 8);

// Art for sale (prints, card sets), shown as a three-up grid.
const art = forSale(products.filter((p) => p.data.category === 'prints' || p.data.category === 'cards')).slice(0, 3);

const firstIn = (category: Category) =>
  products.find((p) => p.data.category === category && isPurchasable(p)) ?? products.find((p) => p.data.category === category);
const tiles = [
  {
    label: 'Necklaces',
    href: '/shop/necklaces',
    product: products.find((p) => p.id === 'brazil-necklace' && isPurchasable(p)) ?? firstIn('necklaces'),
  },
  // Stardust's second photo is the artwork edge to edge, so it fills the arch with no paper border.
  { label: 'Prints', href: '/shop/prints', product: products.find((p) => p.id === 'stardust') ?? firstIn('prints'), image: 1 },
  // Cards only get a tile while a set is for sale; sold sets live on the cards page.
  { label: 'Watercolor cards', href: '/shop/cards', product: products.find((p) => p.data.category === 'cards' && isPurchasable(p)) },
  { label: 'Paintings', href: '/art', product: originals.find((p) => p.id === 'plastic-chandelier') ?? originals[0] },
].filter((t) => t.product);

const { rating } = site;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.studio,
    url: site.url,
    email: site.email,
    logo: `${site.url}/brand/simone-chagoya-logo.png`,
    address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
    sameAs: Object.values(site.social).filter(Boolean),
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url },
];
---

<Base jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Gemstone jewelry and art · Chicago</p>
        <h1 class="hero-title">
          <span class="line"><span>Memory,</span></span>
          <span class="line"><span>in <em>stone.</em></span></span>
        </h1>
        <p class="lede hero-lede">
          Natural gemstone necklaces, original paintings, and signed prints by Simone Chagoya. A painter’s eye for color,
          line and form, handmade in Chicago.
        </p>
        <div class="hero-ctas">
          <a class="btn" href="/shop/jewelry">Shop jewelry <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost hero-art" href="/art">The art <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        {
          rating.count > 0 && (
            <p class="hero-rating">
              <span class="stars" aria-hidden="true">
                ★★★★★
              </span>
              {rating.average.toFixed(1)} from {rating.count} verified reviews
            </p>
          )
        }
      </div>

      <div class="hero-visual">
        {/* The necklace and the painting side by side, in the same order as the buttons: jewelry, then art. */}
        {
          heroPiece && (
            <a class="hero-piece" href={productUrl(heroPiece)}>
              <span class="arch zoom hero-piece-media">
                <ProductMedia
                  product={heroPiece}
                  index={heroPieceImage}
                  mode="cover"
                  sizes="(min-width: 960px) 24vw, 46vw"
                  widths={[360, 540, 720, 960]}
                  loading="eager"
                />
              </span>
              <span class="hero-piece-info">
                <span class="hero-piece-label">Signature piece</span>
                <span class="hero-piece-title">{heroPiece.data.title}</span>
                <span class="hero-piece-price"><Price product={heroPiece} /></span>
              </span>
            </a>
          )
        }

        <figure class="hero-painting">
          <div class="arch hero-arch">
            <Picture
              src={heroPainting}
              formats={['avif', 'webp']}
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 960px) 24vw, 46vw"
              alt="Altered Beliefs, a 2010 oil painting by Simone Chagoya of a rock cave with an orange floor"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption><em>Altered Beliefs</em>, 2010<span class="hero-medium"> · Oil on canvas</span></figcaption>
        </figure>

        {/*
          Two phrases, each stretched to exactly the same length and centered on its half of the
          circle, so the two dots between them sit at precisely opposite points with equal space
          on either side. The path starts at 9 o'clock and runs clockwise.
        */}
        <svg class="hero-seal" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="seal-circle" d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0"></path></defs>
          <circle class="seal-bg" cx="100" cy="100" r="98"></circle>
          <circle class="seal-ring" cx="100" cy="100" r="54"></circle>
          <text text-anchor="middle">
            <textPath href="#seal-circle" startOffset="25%" textLength="186" lengthAdjust="spacing">Simone Chagoya Studio</textPath>
          </text>
          <text text-anchor="middle">
            <textPath href="#seal-circle" startOffset="75%" textLength="186" lengthAdjust="spacing">Handmade in Chicago</textPath>
          </text>
          <circle class="seal-dot" cx="23.4" cy="100" r="1.7"></circle>
          <circle class="seal-dot" cx="176.6" cy="100" r="1.7"></circle>
          <path class="seal-diamond" d="M100 88 112 100 100 112 88 100Z"></path>
        </svg>
      </div>
    </div>
  </section>

  <SaleNote />

  <Marquee items={['Natural gemstones', 'Strung by hand in Chicago', 'One of one', 'Love, beauty, new beginnings', 'Memory, in stone']} />

  <!-- Categories -->
  <section class="section container">
    <div class="section-head section-head--center">
      <p class="eyebrow eyebrow--center">The studio</p>
      <h2 class="h2">Find your <em>piece</em></h2>
    </div>
    <div class="tiles" style={`--tiles: ${tiles.length}`}>
      {
        tiles.map((tile, i) => (
          <a class="tile" href={tile.href} data-reveal style={`--reveal-delay: ${i * 110}`}>
            <div class="arch zoom tile-media">
              <ProductMedia product={tile.product!} index={tile.image} mode="cover" sizes="(min-width: 960px) 30vw, 46vw" />
            </div>
            <span class="tile-label">{tile.label}</span>
            <span class="tile-cta">
              Explore <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- The stones -->
  {
    stones.length > 0 && (
      <section class="stones section">
        <div class="container">
          <div class="stones-head">
            <div>
              <p class="eyebrow">The necklaces</p>
              <h2 class="h2" data-reveal>
                Every stone <em>has a name</em>
              </h2>
            </div>
            <div data-reveal style="--reveal-delay: 150">
              <p class="lede">
                Simone chooses stones the way she chooses paint: for color, light and harmony. Each necklace is strung by
                her hands, embedded with powerful meanings and natural elements.
              </p>
              <a class="link stones-all" href="/shop/necklaces">
                All necklaces <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <ul class="pairs">
            {stones.map((piece) => (
              <li class="pair">
                <a href={productUrl(piece)}>
                  <div class="pair-piece">
                    <ProductMedia product={piece} mode="cover" sizes="(min-width: 1480px) 340px, (min-width: 901px) 23vw, 68vw" />
                  </div>
                  <div class="pair-caption">
                    <span class="pair-name">{piece.data.title.replace(/ Necklace$/, '')}</span>
                    <span class="pair-from">{shortMaterial(piece)}</span>
                    <span class="pair-link">
                      <Price product={piece} /> <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Brand band -->
  <section class="band" aria-label="Simone Chagoya Studio" data-pond-band>
    <Image src={water} alt="" widths={[800, 1200, 1600, 2400, 3200]} sizes="100vw" format="webp" quality={76} class="band-img" />
    <canvas class="band-canvas" aria-hidden="true" data-pond></canvas>
    <p class="band-hint" aria-hidden="true" data-pond-hint>Touch the water</p>
    {/* The photograph is CC BY-SA 4.0, so it carries its credit, and our graded crop shares its license. */}
    <p class="band-credit">
      Water:{' '}
      <a href="https://commons.wikimedia.org/wiki/File:Ripples_and_sunlight_pattern_in_Brofjorden.jpg" rel="noopener" target="_blank">W.carter</a>,
      adapted,{' '}
      <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener license" target="_blank">CC BY-SA 4.0</a>
    </p>
    <div class="lockup" data-reveal>
      <Logo variant="lockup" class="lockup-mark" />
    </div>
  </section>

  <!-- Art for sale -->
  {
    art.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Prints and watercolors</p>
            <h2 class="h2">
              Art to <em>keep</em>
            </h2>
          </div>
          <a class="link" href="/shop/art">
            Shop art <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class:list={['grid', { 'grid--short': art.length < 3 }]}>
          {art.map((p, i) => (
            <ProductCard product={p} delay={i * 110} sizes="(min-width: 1100px) 31vw, (min-width: 760px) 45vw, 50vw" />
          ))}
        </div>
      </section>
    )
  }

  <!-- Statement -->
  <section class="statement section container">
    <p class="eyebrow eyebrow--center">From the artist statement</p>
    <blockquote>
      <p data-reveal>Memory is not always accurate; it can even change over time.</p>
    </blockquote>
    <a class="link" href="/about">Read Simone’s story <span aria-hidden="true">→</span></a>
  </section>

  <!-- Paintings rail -->
  {
    originals.length > 0 && (
      <section class="section section--flush-top">
        <div class="container section-head">
          <div>
            <p class="eyebrow">The paintings</p>
            <h2 class="h2">
              Oil on canvas, <em>one of each</em>
            </h2>
          </div>
          <div class="rail-controls">
            <button type="button" class="rail-btn" data-rail-prev aria-label="Previous paintings">
              ←
            </button>
            <button type="button" class="rail-btn" data-rail-next aria-label="Next paintings">
              →
            </button>
            <a class="link" href="/art">
              See all {originals.length}
            </a>
          </div>
        </div>
        <div class="rail" tabindex="0" aria-label="Original paintings, scroll sideways" data-rail>
          {originals.slice(0, 10).map((p) => (
            <div class="rail-item">
              <ProductCard product={p} sizes="(min-width: 960px) 26vw, 72vw" />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Promises -->
  <section class="promises container" aria-label="Why buy from the studio">
    <div class="promise" data-reveal>
      <span class="promise-n">i.</span>
      <h3>Strung by hand</h3>
      <p>Natural stones, chosen, strung and finished in Simone’s Chicago studio.</p>
    </div>
    <div class="promise" data-reveal style="--reveal-delay: 110">
      <span class="promise-n">ii.</span>
      <h3>One of one</h3>
      <p>Natural stones are never identical, so neither are the necklaces. When one sells, it is gone.</p>
    </div>
    <div class="promise" data-reveal style="--reveal-delay: 220">
      <span class="promise-n">iii.</span>
      <h3>Ready to give</h3>
      <p>
        Gift wrapped by hand and shipped in {site.shipping.processing}, tracked to your door. Free US shipping over
        ${site.shipping.freeThreshold}.
      </p>
    </div>
    <div class="promise" data-reveal style="--reveal-delay: 330">
      <span class="promise-n">iv.</span>
      <h3>{site.returns.days}-day returns</h3>
      <p>
        Unworn, ready-to-ship jewelry can come back within {site.returns.days} days of delivery.{' '}
        <a href="/shipping-returns">Read the return policy</a>.
      </p>
    </div>
  </section>

  <Reviews />

  <!-- Commissions -->
  <section class="commission">
    <div class="container commission-grid">
      <div class="commission-copy">
        <p class="eyebrow">Commissions</p>
        <h2 class="commission-title" data-reveal>Something made <em>only for you</em></h2>
        <p class="lede" data-reveal style="--reveal-delay: 120">
          A necklace in your colors, a stone that means something, a painting of a place you love. Tell Simone what you
          have in mind and she will make it by hand.
        </p>
        <a class="btn" href="/commissions">Begin a commission <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <figure class="commission-image" data-reveal="mask">
        <div class="arch">
          <Image
            src={doorPainting}
            alt="Regarding My Wayward Ways, 2009, oil painting of a wooden door set in rock"
            widths={[420, 640, 900]}
            sizes="(min-width: 900px) 34vw, 80vw"
            format="webp"
            quality={78}
          />
        </div>
      </figure>
    </div>
  </section>
</Base>

<style>
  /* Hero ------------------------------------------------------------ */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 6rem) clamp(4rem, 8vw, 8rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 7rem);
    align-items: center;
  }

  /* Wide screens have room to give the arches more width without wrapping the title. */
  @media (min-width: 1320px) {
    .hero-grid {
      grid-template-columns: 1fr 1.15fr;
    }
  }

  .hero-eyebrow {
    margin-bottom: clamp(1.75rem, 3.5vw, 3rem);
    animation: fade 1.6s 0.1s var(--ease-out) both;
  }

  .hero-title {
    font-size: var(--step-6);
    font-weight: 300;
    line-height: 0.86;
    letter-spacing: -0.03em;
  }

  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .hero-title .line > span {
    display: inline-block;
    animation: rise 1.8s var(--ease-out) both;
  }

  .hero-title .line:nth-child(2) > span {
    animation-delay: 0.15s;
    padding-left: 0.6em;
  }

  .hero-title em {
    font-weight: 300;
    color: var(--accent);
  }

  .hero-lede {
    margin-top: clamp(1.75rem, 3vw, 2.75rem);
    animation: fade 1.6s 0.45s var(--ease-out) both;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.5rem;
    margin-top: 2.5rem;
    animation: fade 1.6s 0.6s var(--ease-out) both;
  }

  /*
    The painting arch stands larger and higher at the back; the necklace arch comes forward,
    lower and to the left, overlapping it like two pieces hung close on one wall.
  */
  .hero-visual {
    --seal: clamp(5.5rem, 8vw, 7.5rem);
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    animation: fade 2s 0.2s var(--ease-out) both;
  }

  .hero-painting {
    grid-column: 5 / -1;
    grid-row: 1;
    z-index: 1;
  }

  .hero-piece {
    grid-column: 1 / 7;
    grid-row: 1;
    z-index: 2;
    margin-top: 31%;
  }

  .hero-arch :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* A paper rim cuts the front arch cleanly out of the painting behind it. */
  .hero-piece-media {
    box-shadow:
      0 0 0 clamp(0.35rem, 0.6vw, 0.55rem) var(--paper),
      0 40px 70px -35px rgb(33 28 23 / 0.45);
  }

  .hero-painting figcaption,
  .hero-piece-info {
    margin-top: 1rem;
  }

  .hero-painting figcaption {
    font-size: var(--step--1);
    color: var(--ink-2);
    text-align: right;
  }

  /* Stamped on the painting's left shoulder, above the necklace. */
  .hero-seal {
    position: absolute;
    z-index: 3;
    top: 5%;
    left: calc(100% / 3);
    width: var(--seal);
    translate: -42% 0;
    animation: spin 60s linear infinite;
  }

  .seal-bg {
    fill: var(--paper);
  }

  .seal-ring {
    fill: none;
    stroke: var(--gold);
    stroke-width: 0.75;
  }

  .hero-seal text {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    fill: var(--ink);
  }

  .seal-dot,
  .seal-diamond {
    fill: var(--gold);
  }

  /* The secondary call to action sweeps to the same clay as the primary. */
  .hero-art {
    --btn-hover: var(--accent);
  }

  .hero-art:hover,
  .hero-art:focus-visible {
    color: #fff;
  }

  .hero-piece {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* A faint keyline inside each arch, so a pale photo still holds the arch shape against the page. */
  .hero-piece-media,
  .hero-arch {
    display: block;
    position: relative;
  }

  .hero-piece-media::after,
  .hero-arch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(33 28 23 / 0.09);
    pointer-events: none;
  }

  .hero-piece-info {
    display: grid;
    gap: 0.25rem;
  }

  .hero-piece-label {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .hero-piece-title {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 450;
    line-height: 1.05;
  }

  .hero-piece-price {
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title .line > span,
    .hero-eyebrow,
    .hero-lede,
    .hero-ctas,
    .hero-visual,
    .hero-rating,
    .hero-seal {
      animation: none;
    }
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-title {
      font-size: clamp(4.6rem, 22vw, 8rem);
    }

    .hero-visual {
      --seal: clamp(4.5rem, 17vw, 6rem);
      max-width: 40rem;
      width: 100%;
      justify-self: center;
    }

    /* One column: the front arch drops a little further so its caption clears the painting. */
    .hero-piece {
      margin-top: 40%;
    }
  }

  @media (max-width: 520px) {
    /* Two full-width buttons stack cleanly instead of one wrapping under the other. */
    .hero-ctas .btn {
      flex: 1 1 100%;
    }

    .hero-medium {
      display: none;
    }
  }

  /* Sections -------------------------------------------------------- */
  .section--tight,
  .section--flush-top {
    padding-top: 0;
  }

  .section-head--center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-head--center .eyebrow {
    margin-bottom: 0.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(3rem, 5vw, 5rem) clamp(1.25rem, 2.5vw, 2.5rem);
  }

  /* Fewer than three pieces: keep the card size and center them instead of leaving a gap. */
  @media (min-width: 761px) {
    .grid--short {
      grid-template-columns: repeat(auto-fit, calc((100% - 2 * clamp(1.25rem, 2.5vw, 2.5rem)) / 3));
      justify-content: center;
    }
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.75rem 1rem;
    }
  }

  /* Tiles */
  .tiles {
    display: grid;
    grid-template-columns: repeat(var(--tiles, 4), 1fr);
    max-width: calc(var(--tiles, 4) * 22rem);
    margin-inline: auto;
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  .tile {
    display: grid;
    justify-items: center;
    text-align: center;
    text-decoration: none;
  }

  .tile-media {
    width: 100%;
  }

  .tile-label {
    margin-top: 1.5rem;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.2rem);
    font-weight: 400;
    line-height: 1;
  }

  .tile-cta {
    margin-top: 0.7rem;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color 0.4s;
  }

  .tile:hover .tile-cta {
    color: var(--accent);
  }

  /* Two up on phones; an odd last tile sits centered rather than orphaned left. */
  @media (max-width: 760px) {
    .tiles {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2.5rem 1rem;
    }

    .tile {
      flex: 0 0 calc(50% - 0.5rem);
    }
  }

  /* Stones -------------------------------------------------------- */
  .stones {
    background: var(--paper-2);
  }

  .stones-head {
    display: grid;
