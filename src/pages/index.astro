  /* Rail ------------------------------------------------------------ */
  .rail-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .rail-controls .link {
    margin-left: 1.25rem;
  }

  .rail-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-family: var(--serif);
