    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding: 0 var(--gutter) 1.5rem;
    max-width: calc(var(--max) + (100vw - var(--max)) / 2);
    margin-left: auto;
    scrollbar-width: none;
