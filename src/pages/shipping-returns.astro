---
import Page from '../layouts/Page.astro';
import { site } from '../data/site';
import { formatPrice } from '../lib/catalog';

const { shipping, returns } = site;
// The order-by line drops off once its date has passed: at build time, and in the browser for pages built before then.
const cutoff = shipping.cutoff && Date.now() < Date.parse(`${shipping.cutoff.until}T23:59:59-06:00`) ? shipping.cutoff : null;
---

<Page
  title="Shipping and returns"
  eyebrow="Help"
  description={`How Simone Chagoya Studio ships orders from ${site.city}. All purchases are final sale.`}
>
  <p class="lede" slot="lede">Everything ships from the studio in {site.city}.</p>

  <h2>Shipping</h2>
  <ul>
    <li>Ready-to-ship pieces leave the studio in {shipping.processing}.</li>
    <li>
      Standard US shipping is {formatPrice(shipping.standardRate)}{shipping.freeThreshold > 0 && `, and complimentary on orders over ${formatPrice(shipping.freeThreshold)}`}.
      It usually arrives 4 to 8 business days after your order via {shipping.carrier} with tracking. Delivery to Alaska
      and Hawaii may take longer.
    </li>
    {
      cutoff && (
        <li data-until={cutoff.until}>
          <strong>{cutoff.note}</strong> {cutoff.detail}
        </li>
      )
    }
    <li>Express shipping is {formatPrice(shipping.expressRate)} and usually arrives in 2 to 4 business days.</li>
    <li>Every order ships with tracking. You will get the number by email as soon as it leaves.</li>
    <li>Made-to-order pieces and commissions have their own timelines, agreed with you before work starts.</li>
    <li>Right now the shop ships within the United States. For international orders, <a href="/commissions">get in touch</a>.</li>
  </ul>

  <h2>Original paintings</h2>
  <p>
    Originals are packed and shipped by a specialist art shipper, fully insured. Shipping is quoted separately when you
    inquire, and local pickup in Chicago is welcome.
  </p>

  <h2>Returns</h2>
  <p>
    <strong>{returns.policy}</strong> This covers jewelry, prints, watercolor card sets, original paintings, commissions
    and custom pieces.
  </p>

  <h2>Something wrong?</h2>
  <p>
    If anything arrives damaged, email a photo to <a href={`mailto:${site.email}`}>{site.email}</a> within{' '}
    {returns.damageDays} days of delivery and Simone will repair or replace it. For anything else,{' '}
    <a href="/commissions">get in touch</a>.
  </p>
</Page>

<script is:inline>
  // Hide a seasonal order-by date once it has passed, on pages built before then.
  document.querySelectorAll('[data-until]').forEach((el) => {
    if (Date.now() > Date.parse(el.dataset.until + 'T23:59:59-06:00')) el.remove();
  });
</script>
