---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/brand/simone-portrait.jpg';
import detail from '../assets/art/plastic-chandelier.jpg';
import { site } from '../data/site';

// Simone's artist statement, unchanged from the original site.
const statement = [
  'Memory is the main influence throughout my work.',
  'I combine my memories of places, times or objects into the piece.',
  'This distorts the real physical depiction into an altered image.',
  'The altered image then includes, excludes or manipulates what the real place or objects actually were or are.',
  'It is a greater representation of both the real and my memory.',
  'Many of my paintings can be related back to childhood or to the places I have been.',
  'Memory is not always accurate; it can even change over time.',
  'As I have grown older I want more and more to remember these things and to still have some grasp on them.',
];

// Wall-label facts. Sources: Simone's printed bio (2024), her portfolio captions, price list and updates in Drive.
const facts = [
  { term: 'Mediums', lines: ['Oil on canvas, watercolor and ink, mixed media, digital painting, natural gemstones'] },
  { term: 'Lives and works', lines: ['Chicago, Illinois'] },
];

const education = [
  {
    year: '2011',
    shows: ['Bachelor of Fine Arts, the School of the Art Institute of Chicago', 'The Distinguished Scholars Annual Merit Scholarship'],
  },
];

// Simone's giving, in her own words (updates doc, November 2026).
const giving = [
  {
    when: 'February 2026',
    cause: 'Supporting Immigrant Rights',
    gift: '20% of every sale went to organizations supporting immigrant children, families, and refugees:',
    orgs: [
      {
        name: 'The Young Center for Immigrant Children’s Rights',
        does: 'works on behalf of unaccompanied immigrant children, making sure their safety and wishes count in every decision about their future.',
        site: 'theyoungcenter.org',
        href: 'https://www.theyoungcenter.org/',
      },
      {
        name: 'Illinois Coalition for Immigrant and Refugee Rights (ICIRR)',
        does: 'is a statewide coalition working so immigrants and refugees can take full and equal part in public life.',
        site: 'icirr.org',
        href: 'https://www.icirr.org/',
      },
    ],
  },
  {
    when: 'March 2026',
    cause: 'Women’s History Month',
    gift: '10% of shop profits went to organizations supporting women’s rights:',
    orgs: [
      {
        name: 'Chicago Foundation for Women (CFW)',
        does: 'funds community organizers and neighborhood groups that break down barriers for women, girls, and gender-expansive people.',
        site: 'cfw.org',
        href: 'https://cfw.org/',
      },
      {
        name: 'National Organization for Women (NOW)',
        does: 'is a national organization working for equality and justice for women.',
        site: 'now.org',
        href: 'https://now.org/',
      },
    ],
  },
  {
    when: 'April 2026',
    cause: 'National Donate Life Month',
    gift: '10% of shop profits went to Donate Life America, a national nonprofit that encourages people to register as organ, eye, and tissue donors.',
    link: { site: 'donatelife.net', href: 'https://donatelife.net/' },
    orgs: [],
  },
];

const exhibitions = [
  { year: '2024', shows: ['Penny Lane Studios, Logan Square, Chicago'] },
  {
    year: '2013',
    shows: [
      'Frogman Gallery, Chicago Artists Month Pop Up Gallery, 23 E Madison St., Chicago, IL',
      'Milwaukee Avenue Arts Festival, Logan Square, Chicago, IL',
    ],
  },
  {
    year: '2011',
    shows: [
      'Amdur Productions Gold Coast Art Fair, School of the Art Institute of Chicago Emerging Artist Group, Chicago, IL',
      'School of the Art Institute of Chicago Spring Undergraduate Exhibition, Sullivan Galleries, Chicago, IL',
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    jobTitle: 'Artist',
    url: `${site.url}/about`,
    image: `${site.url}/brand/simone-chagoya-logo.png`,
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'School of the Art Institute of Chicago', url: 'https://www.saic.edu' },
    address: { '@type': 'PostalAddress', addressLocality: 'Chicago', addressRegion: 'IL', addressCountry: 'US' },
    sameAs: Object.values(site.social).filter(Boolean),
  },
};
---

<Base
  title="About Simone"
  description="Simone Chagoya is a contemporary artist and jewelry designer in Chicago, and a graduate of the School of the Art Institute of Chicago. Every piece is made by hand in her home studio."
  type="article"
  jsonLd={jsonLd}
>
  <section class="about-hero container">
    <div class="about-copy">
      <p class="eyebrow">Contemporary jewelry and fine art</p>
      <h1 class="display">Simone <em>Chagoya</em></h1>
      <p class="lede">
        Simone is a contemporary artist and jewelry designer working across oil paint, watercolor, mixed media, and
        natural gemstones. Every piece in this shop is created by hand in her home studio in Chicago, Illinois.
      </p>
      <p class="credential"><span>BFA</span> School of the Art Institute of Chicago, 2011</p>
    </div>
    <figure class="about-image">
      <div class="about-mask" data-reveal="mask">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[480, 800, 896]}
          sizes="(min-width: 960px) 46vw, 92vw"
          alt="Simone Chagoya in her studio, an easel and paint-covered worktable behind her"
          loading="eager"
        />
      </div>
      <figcaption>Simone in her Chicago studio</figcaption>
    </figure>
  </section>

  <section class="section container bio" aria-labelledby="bio-title">
    <div class="bio-copy" data-reveal>
      <h2 id="bio-title" class="eyebrow">Background</h2>
      <p class="bio-lead">
        Simone grew up in Illinois, about an hour outside Chicago. Family trips into the city meant museums, neighborhoods,
        restaurants, and festivals, and the city stayed with her.
      </p>
      <p>
        The natural world shaped her just as much: she spent many days in both of her grandmothers’ gardens and learned
        about plants and flowers from her mother. Her heritage is Indigenous Mexican and Norwegian, and both are a deep part
        of who she is.
      </p>
      <p>In every way, her background influences her work, passion, and artistry across all mediums.</p>
      <p>
        She studied painting and art history at the School of the Art Institute of Chicago and earned her BFA in 2011.
        Three of the paintings on this site, <a href="/products/altered-beliefs"><em>Altered Beliefs</em></a>,{' '}
        <a href="/products/regarding-my-wayward-ways"><em>Regarding My Wayward Ways</em></a> and{' '}
        <a href="/products/transcendence-into-white"><em>Transcendence Into White</em></a>, hung in her BFA exhibition
        that May.
      </p>
    </div>
    <dl class="wall-label" data-reveal style="--reveal-delay: 120">
      {
        facts.map((f) => (
          <div class="wall-label-row">
            <dt>{f.term}</dt>
            {f.lines.map((line) => (
              <dd>{line}</dd>
            ))}
          </div>
        ))
      }
      {
        [
          { term: 'Education', rows: education },
          { term: 'Exhibitions', rows: exhibitions },
        ].map((block) => (
          <div class="wall-label-row">
            <dt>{block.term}</dt>
            <dd>
              <ol class="exhibitions">
                {block.rows.map((e) => (
                  <li>
                    <span class="exhibition-year">{e.year}</span>
                    <ul>
                      {e.shows.map((show) => (
                        <li>{show}</li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ol>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="statement-scroll" aria-labelledby="statement-title">
    <div class="container">
      <h2 id="statement-title" class="eyebrow">Artist statement</h2>
      <ol class="statement-lines">
        {statement.map((line) => <li>{line}</li>)}
      </ol>
    </div>
  </section>

  <section class="section container studio" aria-labelledby="studio-title">
    <div class="studio-head" data-reveal>
      <p class="eyebrow">The studio</p>
      <h2 id="studio-title" class="h2">Simone Chagoya <em>Studio</em></h2>
      <p class="studio-tag">Gemstone Jewelry &amp; Fine Art, Handcrafted in Chicago</p>
    </div>
    <div class="studio-copy" data-reveal style="--reveal-delay: 120">
      <p>
        Her visual art explores earth elements and human emotion, and her jewelry practice reflects that same sensibility:
        one-of-a-kind pieces that feel expressive, intimate, and distinctly handcrafted. She believes jewelry is wearable
        art, and every piece she makes reflects that intention.
      </p>
      <p>
        As a graduate of the School of the Art Institute of Chicago, Simone approaches each artwork and jewelry piece as an
        original, deeply personal creation. Her process starts with raw materials and an instinct for color and form,
        resulting in work that feels both contemporary and timeless. Each piece is a work of art, drawn from nature and
        created to inspire.
      </p>
      <p>
        Working from her home studio, she handles every step of the process, from the first sketch to the final polish.
        Each piece passes through her hands alone.
      </p>
      <p class="studio-close">
        When you buy from this shop, you’re supporting a small, one-woman studio and a slower, more intentional way of
        making things.
      </p>
    </div>
  </section>

  <section class="section container practices">
    <article class="practice" data-reveal>
      <span class="practice-n">i.</span>
      <h2 class="h3">Painting</h2>
      <p>
        Oil on canvas, watercolor and signed prints. Rooms, landscapes seen through a car window, jungle leaves and night
        skies, built up until they sit somewhere between the real thing and the remembered one.
      </p>
      <a class="link" href="/art">See the art <span aria-hidden="true">→</span></a>
    </article>
    <article class="practice" data-reveal style="--reveal-delay: 120">
      <span class="practice-n">ii.</span>
      <h2 class="h3">Jewelry</h2>
      <p>
        Natural gemstones chosen the way a painter chooses color, then strung by hand. Every necklace is named for what it
        holds: Smoke, Cosmic, Brazil, Baja and the rest. Most are made once.
      </p>
      <a class="link" href="/shop/necklaces">Shop necklaces <span aria-hidden="true">→</span></a>
    </article>
    <figure class="practice-image" data-reveal style="--reveal-delay: 200">
      <Picture
        src={detail}
        formats={['avif', 'webp']}
        widths={[400, 700, 1000]}
        sizes="(min-width: 960px) 30vw, 92vw"
        alt="Plastic Chandelier, 2008, oil on canvas by Simone Chagoya"
      />
    </figure>
  </section>

  <section class="section container giving" id="giving-back" aria-labelledby="giving-title">
    <div class="giving-head" data-reveal>
      <p class="eyebrow">Beyond the studio</p>
      <h2 id="giving-title" class="h2">Giving <em>Back</em></h2>
      <p class="lede">
        Handmade with love, and shared beyond the studio. A few times a year, part of my shop’s sales goes to causes
        close to my heart.
      </p>
    </div>
    <div class="giving-grid">
      {
        giving.map((g, i) => (
          <article class="gift" data-reveal style={`--reveal-delay: ${i * 110}`}>
            <p class="gift-when">{g.when}</p>
            <h3 class="h3">{g.cause}</h3>
            <p class="gift-share">
              {g.gift}
              {g.link && (
                <>
                  {' '}
                  <a href={g.link.href} target="_blank" rel="noopener">
                    {g.link.site}
                  </a>
                </>
              )}
            </p>
            {g.orgs.length > 0 && (
              <ul class="gift-orgs">
                {g.orgs.map((o) => (
                  <li>
                    <strong>{o.name}</strong> {o.does}{' '}
                    <a href={o.href} target="_blank" rel="noopener">
                      {o.site}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {g.when === 'April 2026' && (
              <p class="gift-note">
                I gave in memory of a family member who needed a lifesaving organ donor. I’m a registered donor myself,
                and if you haven’t registered yet, I hope you’ll consider it. It’s a powerful gift. Illinois residents
                can register at{' '}
                <a href="https://www.lifegoeson.com/" target="_blank" rel="noopener">
                  LifeGoesOn.com
                </a>
                , and anyone can learn more at{' '}
                <a href="https://donatelife.net/" target="_blank" rel="noopener">
                  donatelife.net
                </a>
                .
              </p>
            )}
          </article>
        ))
      }
    </div>
    <aside class="foundation" data-reveal aria-labelledby="foundation-title">
      <p class="eyebrow">Our foundation</p>
      <div>
        <h3 id="foundation-title" class="h3">The Simone M. Chagoya and Ryan J. Smith Foundation</h3>
        <p class="foundation-text">
          Ryan and I started a foundation together. It’s working to make Chicago the next technology hub, beginning
          with a book for every student in the city’s public high schools.{' '}
          <a href="https://chagoyasmith.org" target="_blank" rel="noopener">chagoyasmith.org</a>
        </p>
      </div>
    </aside>
    <p class="giving-thanks" data-reveal>Thank you to everyone whose purchase was part of this impact.</p>
  </section>

  <section class="about-cta">
    <div class="container about-cta-inner">
      <h2 class="h2">Say <em>hello.</em></h2>
      <p class="lede">Questions about a piece, a commission or a stockist inquiry. Simone reads every message.</p>
      <div class="about-cta-actions">
        <a class="btn" href="/commissions">Get in touch <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) 0;
  }

  .about-copy .eyebrow {
    margin-bottom: 1.25rem;
  }

  .about-copy .lede {
    margin-top: 2rem;
  }

  .credential {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }

  .credential span {
    font-family: var(--serif);
    font-size: 1.35rem;
    font-style: italic;
    color: var(--gold);
  }

  /* Sits close under the portrait instead of a full section gap below it. */
  .bio {
    padding-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .bio-copy .eyebrow {
    margin-bottom: 1.5rem;
  }

  .bio-copy p {
    max-width: 58ch;
    color: var(--ink-2);
  }

  .bio-copy p + p {
    margin-top: 1.1rem;
  }

  .bio-copy .bio-lead {
    font-family: var(--serif);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.2;
    color: var(--ink);
    text-wrap: balance;
    margin-bottom: 1.5rem;
  }

  .bio-copy a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.2em;
  }

  .wall-label {
    margin: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--paper-2);
    border-radius: 2px;
  }

  .wall-label-row + .wall-label-row {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .wall-label dt {
    margin-bottom: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .wall-label dd {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--ink);
  }

  .wall-label dd + dd {
    margin-top: 0.3rem;
  }

  /* Exhibitions read like a CV: small type, the year hung in its own column. */
  .exhibitions,
  .exhibitions ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .exhibitions > li {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 0 0.5rem;
    font-family: var(--sans);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .exhibitions > li + li {
    margin-top: 0.75rem;
  }

  .exhibitions ul li + li {
    margin-top: 0.4rem;
  }

  .exhibition-year {
    font-family: var(--serif);
    font-size: 1rem;
    font-style: italic;
    line-height: 1.35;
    color: var(--gold-text);
  }

  .about-image :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 999px 999px 0 0;
  }

  .about-image figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .statement-scroll {
    background: var(--ink);
    color: var(--paper);
    padding-block: var(--section);
  }

  .statement-scroll .eyebrow {
    color: rgb(244 239 231 / 0.6);
    margin-bottom: 3rem;
  }

  .statement-scroll .eyebrow::before {
    background: var(--gold-light);
  }

  .statement-lines {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }

  .statement-lines li {
    max-width: 24ch;
    font-family: var(--serif);
    font-size: var(--step-4);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .statement-lines li:nth-child(even) {
    margin-left: auto;
    text-align: right;
  }

  .statement-lines li:nth-child(7) {
    color: var(--gold-light);
    font-style: italic;
  }

  /* Each line brightens as it crosses the middle of the screen */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .statement-lines li {
        animation: brighten linear both;
        animation-timeline: view();
        animation-range: cover 10% cover 45%;
      }

      @keyframes brighten {
        from {
          opacity: 0.18;
          transform: translateY(24px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }

  .studio {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .studio-head .eyebrow {
    margin-bottom: 1.25rem;
  }

  .studio-tag {
    margin-top: 1.25rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  .studio-copy p {
    max-width: 58ch;
    color: var(--ink-2);
  }

  .studio-copy p + p {
    margin-top: 1.1rem;
  }

  .studio-copy .studio-close {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--ink);
    text-wrap: balance;
  }

  /* The two practices follow straight on from the studio text. */
  .studio + .practices {
    padding-top: 0;
  }

  .practices {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .practice-n {
    display: block;
    margin-bottom: 1.25rem;
    font-family: var(--serif);
    font-size: 1.4rem;
    font-style: italic;
    color: var(--gold);
  }

  .practice h2 {
    margin-bottom: 1rem;
  }

  .practice p {
    color: var(--ink-2);
    margin-bottom: 1.5rem;
  }

  .practice-image :global(img) {
    width: 100%;
    border-radius: 999px 999px 0 0;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .giving {
    border-top: 1px solid var(--line);
  }

  .giving-head {
    max-width: 44rem;
  }

  .giving-head .eyebrow {
    margin-bottom: 1.25rem;
  }

  .giving-head .lede {
    margin-top: 1.5rem;
  }

  .giving-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .gift {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }

  .gift-when {
    margin-bottom: 0.75rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--gold-text);
  }

  .gift-share {
    margin-top: 1rem;
    color: var(--ink);
  }

  .gift-orgs {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .gift-orgs strong {
    font-weight: 500;
    color: var(--ink);
  }

  .gift-note {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .giving a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }

  .foundation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(1rem, 4vw, 4rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }

  .foundation-text {
    margin-top: 1rem;
    max-width: 40rem;
    color: var(--ink-2);
  }

  @media (max-width: 760px) {
    .foundation {
      grid-template-columns: 1fr;
    }
  }

  .giving-thanks {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    font-family: var(--serif);
    font-size: var(--step-2);
    font-style: italic;
    line-height: 1.2;
    text-wrap: balance;
  }

  .about-cta {
    background: var(--paper-2);
    padding-block: var(--section);
  }

  .about-cta-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .about-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 900px) {
    .about-hero,
    .bio,
    .studio,
    .practices,
    .giving-grid {
      grid-template-columns: 1fr;
    }

    .statement-lines li:nth-child(even) {
      margin-left: 0;
