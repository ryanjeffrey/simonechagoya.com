---
import Newsletter from './Newsletter.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
const social = [
  { label: 'Instagram', href: site.social.instagram },
  { label: 'Pinterest', href: site.social.pinterest },
].filter((s) => s.href);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-signup">
        <p class="eyebrow footer-eyebrow">The studio list</p>
        <h2 class="footer-title">First look at <em>new work.</em></h2>
        <Newsletter id="footer-newsletter" tone="dark" source="footer" />
      </div>

      <nav class="footer-cols" aria-label="Footer">
        <div>
          <h3 class="footer-h">Shop</h3>
          <ul>
            <li><a href="/shop/necklaces">Necklaces</a></li>
            <li><a href="/shop/prints">Prints</a></li>
            <li><a href="/shop/originals">Original paintings</a></li>
            <li><a href="/shop">Shop all</a></li>
          </ul>
        </div>
        <div>
          <h3 class="footer-h">Studio</h3>
          <ul>
            <li><a href="/about">About Simone</a></li>
            <li><a href="/art">The paintings</a></li>
            <li><a href="/commissions">Commissions</a></li>
            {social.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h3 class="footer-h">Help</h3>
          <ul>
            <li><a href="/shipping-returns">Shipping and returns</a></li>
            <li><a href="/faq">FAQ and care</a></li>
            <li><a href="/privacy">Privacy policy</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-legal">
      <span>© {year} {site.studio}</span>
      <span>Made by hand in {site.city}</span>
      <span>Secure checkout by Stripe</span>
    </div>

    <div class="footer-mark" aria-hidden="true"><Logo /></div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
    padding-top: var(--section);
    overflow: hidden;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .footer-eyebrow {
    color: rgb(244 239 231 / 0.6);
    margin-bottom: 1.5rem;
  }

  .footer-eyebrow::before {
    background: var(--gold-light);
  }

  .footer-title {
    font-size: var(--step-4);
    font-weight: 300;
    line-height: 0.98;
    margin-bottom: 2.25rem;
  }

  .footer-title em {
    color: var(--gold-light);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-h {
    font-family: var(--sans);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: 1.4rem;
  }

  .footer-cols ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .footer-cols a {
    font-size: 0.95rem;
    text-decoration: none;
    color: rgb(244 239 231 / 0.82);
    transition: color 0.3s;
  }

  .footer-cols a:hover {
    color: var(--paper);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgb(244 239 231 / 0.12);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(244 239 231 / 0.55);
  }

  .footer-mark {
    width: min(100%, 78rem);
    margin: clamp(2rem, 5vw, 4.5rem) auto 0;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--paper);
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
    }

    .footer-cols > div:last-child {
      grid-column: 1 / -1;
    }

    .footer-legal {
      flex-direction: column;
    }
  }
</style>
