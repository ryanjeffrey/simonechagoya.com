---
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false" data-menu-open>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
      <span class="visually-hidden">Open menu</span>
    </button>

    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      Simone Chagoya
    </a>

    <nav class="primary-nav nav-left" aria-label="Shop">
      <ul>
        {
          nav.slice(0, 3).map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-right">
      <nav class="primary-nav" aria-label="Studio">
        <ul>
          {
            nav.slice(3).map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button class="bag-toggle" type="button" data-bag-open aria-haspopup="dialog">
        <span>Bag</span>
        <span class="bag-count"><span data-bag-count aria-live="polite">0</span></span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" id="site-menu" aria-label="Menu" data-menu>
  <div class="menu-inner">
    <div class="menu-top">
      <span class="wordmark wordmark--light">Simone Chagoya</span>
      <button class="menu-close" type="button" data-menu-close>
        Close
      </button>
    </div>
    <nav aria-label="Mobile">
      <ol class="menu-links">
        <li style="--i: 0"><a href="/">Home</a></li>
        {
          nav.map((item, i) => (
            <li style={`--i: ${i + 1}`}>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="menu-foot">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>{site.city}</span>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(244 239 231 / 0.82);
    backdrop-filter: saturate(1.2) blur(18px);
    -webkit-backdrop-filter: saturate(1.2) blur(18px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.5s;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }

  .wordmark {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--serif);
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark--light {
    color: var(--paper);
  }

  .nav-left {
    grid-column: 1;
    grid-row: 1;
  }

  .header-right {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
  }

  .primary-nav ul {
    display: flex;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
    list-style: none;
    padding: 0;
  }

  .primary-nav a,
  .bag-toggle {
    position: relative;
    display: inline-block;
    line-height: 1;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    padding-block: 0.5rem;
  }

  .primary-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease-out);
  }

  .primary-nav a:hover::after,
  .primary-nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .bag-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    justify-self: end;
  }

  .bag-count {
    font-variant-numeric: tabular-nums;
    transition: color 0.4s;
  }

  .bag-count::before {
    content: '(';
  }

  .bag-count::after {
    content: ')';
  }

  .bag-count:has(.is-bumped) {
    color: var(--accent);
  }

  .menu-toggle {
    display: none;
    grid-column: 1;
    grid-row: 1;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -0.6rem;
    place-items: center;
  }

  .menu-icon {
    display: grid;
    gap: 7px;
    width: 24px;
  }

  .menu-icon span {
    display: block;
    height: 1px;
    background: currentColor;
  }

  .menu-icon span:last-child {
    width: 15px;
  }

  @media (max-width: 1080px) {
    .primary-nav {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }
  }

  @media (max-width: 420px) {
    .wordmark {
      font-size: 0.95rem;
      letter-spacing: 0.22em;
      margin-right: -0.22em;
    }
  }

  /* Full-screen menu */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    opacity: 0;
    transition:
      opacity 0.4s var(--ease-out),
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }

  .menu[open] {
    opacity: 1;
  }

  @starting-style {
    .menu[open] {
      opacity: 0;
    }
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu-inner {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    padding: 0 var(--gutter) calc(1.5rem + env(safe-area-inset-bottom));
  }

  .menu-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--header-h);
  }

  .menu-top .wordmark {
    font-size: 0.95rem;
  }

  .menu-close {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.5rem 0;
  }

  .menu-links {
    list-style: none;
    padding: 2rem 0 0;
    counter-reset: menu;
  }

  .menu-links li {
    counter-increment: menu;
    border-bottom: 1px solid rgb(244 239 231 / 0.12);
    transform: translateY(16px);
    opacity: 0;
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 50ms + 80ms);
  }

  .menu[open] .menu-links li {
    transform: none;
    opacity: 1;
  }

  @starting-style {
    .menu[open] .menu-links li {
      transform: translateY(16px);
      opacity: 0;
    }
  }

  .menu-links a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    font-family: var(--serif);
    font-size: clamp(2.6rem, 12vw, 4.4rem);
    font-weight: 300;
    line-height: 1;
    text-decoration: none;
  }

  .menu-links a::before {
    content: counter(menu, decimal-leading-zero);
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: rgb(243 239 231 / 0.5);
    transform: translateY(-1.6em);
  }

  .menu-links a:hover {
    color: var(--gold-light);
  }

  .menu-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--step--1);
    color: rgb(243 239 231 / 0.7);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  openBtn?.addEventListener('click', () => {
    menu?.showModal();
    openBtn.setAttribute('aria-expanded', 'true');
  });
  menu?.addEventListener('close', () => openBtn?.setAttribute('aria-expanded', 'false'));
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
</script>
