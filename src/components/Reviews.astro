---
import { Image } from 'astro:assets';
import { reviews as all } from '../data/reviews';

interface Props {
  product?: string;
  /** On a product page with no reviews of its own, show the shop's reviews instead. */
  fallback?: boolean;
  limit?: number;
}

const { product, fallback = false, limit = 6 } = Astro.props;
const own = product ? all.filter((r) => r.product === product) : all;
const matching = own.length ? own : fallback ? all : [];
const list = matching.slice(0, limit);
// The count and average cover every matching star rating, so they agree with the rating shown elsewhere.
// Words shared without stars (an Instagram post) are shown but not counted.
const rated = matching.filter((r) => r.rating);
const average = rated.length ? rated.reduce((n, r) => n + (r.rating ?? 0), 0) / rated.length : 0;
const allEtsy = rated.every((r) => r.source === 'Etsy');
const label = `From ${rated.length} ${rated.length === 1 ? 'review' : 'reviews'}${allEtsy ? ' on Etsy' : ''}`;
---

{
  list.length > 0 && (
    <section class="reviews section container" aria-labelledby="reviews-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">Kind words</p>
          <h2 id="reviews-title" class="h2">
            {average.toFixed(1)} <em>out of 5</em>
          </h2>
        </div>
        <p class="muted">{label}</p>
      </div>
      <ul class="review-list">
        {list.map((r, i) => (
          <li class="review" data-reveal style={`--reveal-delay: ${(i % 3) * 80}`}>
            {r.photo && (
              <Image class="review-photo" src={r.photo.src} alt={r.photo.alt} widths={[320, 600]} sizes="(min-width: 960px) 30vw, 100vw" loading="lazy" />
            )}
            {r.rating && (
              <p class="review-stars" aria-label={`${r.rating} out of 5 stars`}>
                {'★'.repeat(r.rating)}
                <span>{'★'.repeat(5 - r.rating)}</span>
              </p>
            )}
            <blockquote>{r.text}</blockquote>
            <p class="review-by">
              {r.name}
              {r.source !== 'Direct' && <span> · via {r.source}</span>}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .review-list {
    columns: 3 19rem;
    column-gap: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .review {
    break-inside: avoid;
    margin-bottom: 1.25rem;
    padding: 1.75rem;
    background: var(--paper-2);
  }

  .review-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-bottom: 1.5rem;
  }

  .review-stars {
    color: var(--gold);
    letter-spacing: 0.15em;
  }

  .review-stars span {
    color: var(--paper-3);
  }

  .review blockquote {
    margin: 1rem 0 1.25rem;
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .review-by {
    font-size: var(--step--1);
    font-weight: 560;
  }

  .review-by span {
    font-weight: 420;
    color: var(--ink-2);
  }
</style>
