# Stripe API key. Use a restricted key (rk_...) from a Stripe sandbox until launch,
# then a live restricted key. See README > Launch checklist > Stripe.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...), from Stripe > Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=
# Netlify build hook URL. The webhook calls it after a sale so the piece shows Sold.
NETLIFY_BUILD_HOOK_URL=
# Set to true only once Stripe Tax shows an active Illinois registration.
STRIPE_AUTOMATIC_TAX=false
# Etsy app keystring and shared secret, for `npm run import:etsy -- --api` (sold listings and videos).
# See README > Importing from Etsy > Sold listings and videos. Local only; Netlify does not need them.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
